# Postgres connection string (Neon, Supabase, Railway, etc. all work)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Your deployed URL in production, http://localhost:3000 in dev
NEXTAUTH_URL="http://localhost:3000"

# Resend API key, for sending password-reset emails: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"

# Must be an address on a domain verified in Resend
RESEND_FROM="Tržby <noreply@yourdomain.com>"
